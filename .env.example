# Discord Bot Credentials
DISCORD_TOKEN=dein_bot_token_hier
CLIENT_ID=deine_client_id_hier
GUILD_ID=deine_test_guild_id_hier

# Optional Database & Services (später)
DATABASE_URL="postgresql://user:password@localhost:5432/discordbot"
REDIS_URL="redis://localhost:6379"

# Web-Dashboard Login (Discord OAuth2)
# Client Secret: Discord Developer Portal -> deine App -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=dein_client_secret_hier
# Zufaelliger Schluessel (min. 32 Zeichen), z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DASHBOARD_URL=https://glgbot.brogameryt.de
# Optional: zusaetzliche Rollen/Nutzer mit Dashboard-Zugriff (kommagetrennte IDs)
DASHBOARD_ROLE_IDS=
DASHBOARD_USER_IDS=
