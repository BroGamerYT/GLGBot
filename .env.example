# =====================================================================
#  GLGBot - Konfiguration. Diese Datei als ".env" kopieren und ausfüllen.
#  Die .env NIEMALS ins Git-Repo hochladen (steht in .gitignore).
# =====================================================================

# --- Discord-Bot (Discord Developer Portal -> deine App) -------------
# Bot -> Reset Token
DISCORD_TOKEN=dein_bot_token_hier
# General Information -> Application ID
CLIENT_ID=deine_application_id_hier
# ID deines Discord-Servers (Rechtsklick auf den Server -> "Server-ID kopieren", Entwicklermodus nötig)
# Das ist der Haupt-Server: immer erlaubt, alle Module standardmäßig an.
GUILD_ID=deine_server_id_hier

# --- Mehrere Server (optional, max. 5) ---------------------------------
# Der Bot bleibt nur auf freigegebenen Servern; auf anderen schreibt er dem Owner und geht wieder.
# Weitere Server kannst du hier eintragen ODER im Dashboard unter "Server-Freigabe".
# ALLOWED_GUILD_IDS=123456789012345678,234567890123456789
# Höchstzahl an Servern inkl. Haupt-Server (1-5, Standard 5)
# MAX_GUILDS=5
# Wer die Server-Freigabe verwalten darf (Standard: Owner des Haupt-Servers)
# BOT_OWNER_ID=

# --- Name deiner Community (für Footer, Transkripte, Dashboard) ------
COMMUNITY_NAME=Meine Community
# Anzeigename des Bots in Footern & im Dashboard
BOT_NAME=GLGBot

# --- Web-Dashboard (Discord OAuth2 Login) ----------------------------
# OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=dein_client_secret_hier
# Öffentliche Adresse des Dashboards OHNE / am Ende.
# In Discord unter OAuth2 -> Redirects eintragen: <DASHBOARD_URL>/api/auth/callback
# Lokal zum Testen: http://localhost:3000
DASHBOARD_URL=https://bot.example.com
# Zufälliger Schlüssel (min. 32 Zeichen), z. B. erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: zusätzliche Rollen/Nutzer mit Dashboard-Zugriff (kommagetrennte IDs).
# Owner, Administratoren und "Server verwalten" haben immer Zugriff.
DASHBOARD_ROLE_IDS=
DASHBOARD_USER_IDS=

# --- Optional ----------------------------------------------------------
# Port der internen Bot-Schnittstelle (nur 127.0.0.1, Standard 3101)
# BOT_API_PORT=3101
# Eigenes Token für die interne Schnittstelle (Standard: SESSION_SECRET)
# INTERNAL_API_TOKEN=
# Zeitzone für Geburtstage & Tageswechsel (Standard Europe/Berlin)
# BOT_TIMEZONE=Europe/Berlin
# Daten entfernter Server werden nach so vielen Tagen gelöscht (Standard 30)
# PURGE_REMOVED_GUILDS_DAYS=30
# Wie viele Tage die tägliche Daten-Sicherung (data/_snapshots) aufbewahrt wird (Standard 7)
# DATA_SNAPSHOT_DAYS=7
# Musik-Modus: embedded (Radio & Musik aktiv) oder disabled (aus)
# MUSIC_MODE=embedded
# DJ-Rolle für Musik-Uploads (Rollen-ID). Kann im Economy-Shop (/shop) für Coins verkauft werden.
# Mitglieder mit dieser Rolle dürfen /music upload ohne Upload-Code nutzen.
# MUSIC_DJ_ROLE_ID=
# Radio nach Bot-Neustart automatisch fortsetzen (true) oder nicht (false)
# RADIO_AUTO_RESUME=true
# Separater Mini-Musik-Bot (eigener Token, vom Hauptbot verwaltet: Auto-Start, Auto-Restart)
# Zweite App im Discord Developer Portal anlegen, Bot-Token und Application-ID hier eintragen.
# MUSICBOT_TOKEN=
# MUSICBOT_CLIENT_ID=
# Server für den Musik-Bot (Standard: GUILD_ID)
# MUSIC_GUILD_ID=
# Musik-Bot beim Hauptbot-Start automatisch mitstarten (Standard true)
# MUSICBOT_AUTOSTART=true
# Schlüssel für verschlüsselte Backup-Notfall-Exporte (mind. 32 Zeichen; getrennt von Backups sicher aufbewahren).
# Schlüsselverlust verhindert das Entschlüsseln vorhandener .glgbak-Dateien.
# BACKUP_ENCRYPTION_KEY=
# Während einer Schlüsselrotation alte Schlüssel hier mit Semikolon getrennt vorhalten;
# erst entfernen, wenn alle damit verschlüsselten Backups abgelaufen oder migriert sind.
# BACKUP_PREVIOUS_ENCRYPTION_KEYS=
# Aufbewahrung externer Discord-/S3-Backups in Tagen (1–3650, Standard 90).
# BACKUP_EXTERNAL_RETENTION_DAYS=90
# Pro Server ein geschützter Textkanal, Format: serverId=channelId,serverId=channelId
# Der Exportkanal muss zum jeweiligen Server gehören und nur vertrauenswürdigen Admins zugänglich sein.
# BACKUP_DISCORD_CHANNELS=
# Optionaler AWS-/S3-kompatibler Speicher. Für AWS können Credentials auch aus der Standard-Credential-Chain kommen.
# Bucket sollte privat sein. Der Bot benötigt s3:PutObject, s3:ListBucket und s3:DeleteObject
# für Export und automatische Aufbewahrung; für Lifecycle-Richtlinien zusätzliches Bucket-Admin-Setup.
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ENDPOINT=                 # z. B. https://s3.example.com für S3-kompatible Anbieter
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Eigene Twitch Client-ID für Stream-Benachrichtigungen & Streamer-Suche (optional)
# TWITCH_CLIENT_ID=
