{
  "name": "glgbot",
  "version": "2.29.0",
  "description": "Discord-Bot (TypeScript, discord.js v14) mit Web-Dashboard: VoiceMaster, Live-Streamer, Level, Moderation, Tickets, Free-Games & Game-News",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "set-owner": "tsx src/scripts/setOwner.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "discordjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "@napi-rs/canvas": "1.0.9",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "ffmpeg-static": "^5.3.0",
    "he": "^2.0.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "youtubei.js": "^18.1.0",
    "yt-search": "^2.13.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
